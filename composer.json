{
    "name": "laikait/laika-auth",
    "description": "Multi-guard authentication package for the Laika PHP Framework with OAuth support",
    "type": "library",
    "license": "MIT",
    "keywords": ["laika", "auth", "authentication", "oauth", "php"],
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name":"Showket Ahmed",
            "email":"riyadhtayf@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "Laika\\Auth\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laika": {
            "resources": {
                "models": { "path": "src/Model", "namespace": "Laika\\Auth\\Model" },
                "schemas": { "path": "src/Schema", "namespace": "Laika\\Auth\\Schema" }
            }
        }
    }
}
